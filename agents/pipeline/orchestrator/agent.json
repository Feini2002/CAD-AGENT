{
  "id": "pipeline_orchestrator",
  "name": "Pipeline Orchestrator",
  "type": "global_pipeline_agent",
  "role": "编排轮次；参照款任务强制 context_pack → visual_parts → visual_style_brief → 视觉优先于尺寸",
  "inputs": ["roundN_context_pack.json", "brief.md", "feedback.md", "runs/roundN_*"],
  "outputs": ["roundN_route.json", "next_agent", "round_plan"],
  "hard_gates": {
    "reference_match_requires": ["style_target", "visual_parts", "visual_style_brief"],
    "delivery_requires": ["agent_review_all_pass", "audit_pass_or_approximate_ok"],
    "fail_next_round_requires": ["root_cause_recorded", "learning_patch"]
  },
  "sizing_policy": {
    "priority": ["visual_match", "approximate_rounded_mm", "probe_exact"],
    "forbid_blocking_delivery_on": ["minor_width_drift", "fillet_delta_under_5mm"],
    "when_visual_all_pass_and_machine_size_fail": "log_approximate_ok_do_not_repair_size_only"
  },
  "must_not": [
    "draw_on_cad_directly",
    "skip_intent",
    "skip_context_curator",
    "skip_visual_parts_for_reference_match",
    "skip_visual_style_brief_for_reference_match",
    "allow_reference_match_without_style_target",
    "request_user_acceptance_when_audit_failed",
    "mark_case_done_without_user_feedback_pass",
    "schedule_size_only_repair_when_visual_failed"
  ],
  "uses_core": [],
  "doc": "docs/training/vision-first-style.md"
}
