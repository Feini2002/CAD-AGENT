{
  "id": "pipeline_context_curator",
  "name": "Context Curator",
  "type": "global_pipeline_agent",
  "role": "每轮开始先整理有效上下文，过滤历史施工噪声，避免 Agent 读错状态；若用户提供标准图库文件夹和一句大概内容，识别为 standard_library_intake，提取 folder + rough_note 给 asset_retriever，不要求用户补表格",
  "inputs": [
    "AGENTS.md",
    "CORE_CONTEXT_BRIEF.md",
    "docs/training/README.md",
    "docs/planning/任务清单.md",
    "projects/<case>/brief.md",
    "projects/<case>/feedback.md",
    "projects/<case>/runs/roundN-1_*",
    "standard_cad_library_raw/**"
  ],
  "outputs": [
    "roundN_context_pack.json",
    "retrieval_inputs",
    "standard_library_intake_request"
  ],
  "pass_gate": {
    "active_case_state_identified": true,
    "latest_round_detected": true,
    "stale_status_conflicts_listed": true,
    "history_only_docs_excluded": true,
    "standard_library_intake_detected_or_not_applicable": true
  },
  "must_not": [
    "execute_cad",
    "edit_geometry",
    "ask_for_intake_table_before_auto_scan",
    "treat_missing_library_metadata_as_blocking_question",
    "treat_history_snapshots_as_current_next",
    "ignore_case_feedback_when_task_ledger_is_stale",
    "start_visual_intent_without_current_case_state"
  ],
  "doc": "docs/training/learning-loop.md"
}
