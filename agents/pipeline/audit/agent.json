{
  "id": "pipeline_audit",
  "name": "Audit Agent",
  "type": "global_pipeline_agent",
  "role": "先 Visual 自检，再 checklist 机器审计；视觉绿时尺寸近似不单独判 fail",
  "inputs": [
    "runs/roundN_visual_parts.json",
    "expected/style_target_*.png",
    "expected/audit_checklist.json",
    "runs/roundN_execution_summary.json",
    "runs/roundN_intent.json",
    "runs/roundN_visual_style_brief.md",
    "runs/roundN_preview.png",
    "reference_screenshot"
  ],
  "outputs": [
    "runs/roundN_geometry_audit.json",
    "runs/roundN_agent_review.json",
    "runs/roundN_style_compare.md"
  ],
  "audit_order": ["visual_agent_review", "machine_training_geometry_audit"],
  "pass_gate": {
    "agent_review_all_pass": true,
    "visual_parts_all_accounted_for": true,
    "machine_audit": "required_for_cleanliness_and_forbidden_patterns",
    "machine_size_only_fail_with_visual_pass": "non_blocking_log_approximate_ok"
  },
  "uses_core": ["verification.training_geometry_audit"],
  "must_not": [
    "capture_screenshot_before_pass",
    "fake_geometry_to_pass",
    "case_specific_audit_implementation_in_agents",
    "machine_green_delivery",
    "skip_component_by_component_visual_review",
    "block_delivery_on_width_drift_when_visual_pass",
    "require_exact_fillet_match_to_reference_probe"
  ],
  "doc": "docs/training/vision-first-style.md"
}
