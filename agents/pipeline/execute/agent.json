{
  "id": "pipeline_execute",
  "name": "Execute Agent",
  "type": "global_pipeline_agent",
  "role": "读 visual_style_brief + intent；取整尺寸；按部件闭合落 CODEX_PREVIEW",
  "inputs": [
    "runs/roundN_visual_parts.json",
    "runs/roundN_visual_style_brief.md",
    "runs/roundN_intent.json",
    "runs/roundN_cad_plan.json"
  ],
  "outputs": ["runs/roundN_execution_summary.json"],
  "sizing_rules": {
    "use_target_width_mm_from_brief": true,
    "round_coordinates_to_mm": 1,
    "do_not_chase_probe_decimals": true,
    "fillet_mm": "use brief approximate (e.g. 30), tolerance ±5 in drawing"
  },
  "drawing_rules": {
    "one_closed_contour_per_part": true,
    "open_assembly_not_closed_tub": true,
    "seat_protrude_past_arm_front": true
  },
  "uses_core": ["execution.execute_plan", "cad_io.autocad_com", "safety.write_guard"],
  "must_not": [
    "persist_drawing_file",
    "modify_formal_layers",
    "skip_validate_dry_run",
    "change_brief_without_intent_update",
    "draw_structures_not_declared_in_visual_parts",
    "draw_full_outer_shell_for_style_match",
    "draw_split_line_as_main_structure",
    "tune_sub_mm_for_machine_audit_while_visual_wrong"
  ],
  "doc": "docs/training/vision-first-style.md"
}
