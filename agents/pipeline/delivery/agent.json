{
  "id": "pipeline_delivery",
  "name": "Delivery Agent",
  "type": "global_pipeline_agent",
  "role": "visual 全绿后截图交付；尺寸取整写在汇报里，不暗示毫米级精确",
  "inputs": [
    "runs/roundN_geometry_audit.json",
    "runs/roundN_agent_review.json",
    "runs/roundN_style_compare.md",
    "runs/roundN_visual_parts.json",
    "runs/roundN_visual_style_brief.md",
    "runs/roundN_execution_summary.json",
    "expected/audit_checklist.json"
  ],
  "outputs": ["runs/roundN_preview.png", "runs/roundN_audit_review.md"],
  "uses_core": ["verification.render_preview"],
  "preconditions": ["agent_review_all_pass", "audit_pass_or_approximate_ok"],
  "reporting": {
    "lead_with_visual_comparison": true,
    "state_target_width_as_rounded": true,
    "do_not_claim_sub_mm_accuracy": true
  },
  "must_not": [
    "fullscreen_cad_by_default",
    "imply_table_c_pass_for_training_case",
    "delivery_without_visual_self_review",
    "delivery_without_style_compare",
    "request_user_acceptance_when_agent_review_partial_or_fail",
    "lead_report_with_probe_deltas_over_screenshot"
  ],
  "doc": "docs/training/vision-first-style.md"
}
