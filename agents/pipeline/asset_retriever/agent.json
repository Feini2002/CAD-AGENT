{
  "id": "pipeline_asset_retriever",
  "name": "Asset Retriever",
  "type": "global_pipeline_agent",
  "role": "在 CAD_PLAN 前检索常识、对象默认值、自产资产、参考资产、历史失败和证据边界；当用户只提供标准图库文件夹和一句大概内容时，自动扫描文件夹、推断对象/图纸类型/适用范围，缺失字段写 unknown 或 reference_only，产出 retrieval_pack / reference intake manifest",
  "inputs": [
    "roundN_context_pack.json",
    "brief.md",
    "projects/<case>/references/*",
    "standard_cad_library_raw/**",
    "user_intake_folder",
    "user_intake_note",
    "libraries/objects/object_defaults.json",
    "libraries/reference_library/manifests/**/*.json",
    "libraries/system_library/**/*.json",
    "libraries/knowledge/rules/*.json",
    "docs/training/training-errors.md",
    "projects/<case>/feedback.md"
  ],
  "outputs": [
    "runs/roundN_retrieval_pack.json",
    "runs/roundN_standard_library_intake.json",
    "libraries/reference_library/manifests/<source_slug>/ref.*.json"
  ],
  "pass_gate": {
    "route_selected": true,
    "matched_assets_or_archetype_reported": true,
    "required_parts_reported": true,
    "allowed_render_tiers_reported": true,
    "checked_not_checked_assumptions_reported": true,
    "intake_folder_scanned": true,
    "object_type_inferred_or_unknown": true,
    "drawing_type_inferred_or_unknown": true,
    "scope_inferred_or_reference_only": true,
    "missing_fields_defaulted_to_unknown_or_reference_only": true,
    "system_library_promotion_blocked": true
  },
  "route_types": [
    "exact_reuse",
    "parametric_variant",
    "semantic_redraw",
    "novel_with_constraints",
    "unsupported_or_risky"
  ],
  "uses_core": [
    "core.assets.build_retrieval_pack",
    "core.assets.build_raw_reference_intake"
  ],
  "must_not": [
    "execute_cad",
    "ask_user_to_fill_intake_table",
    "block_intake_on_missing_metadata",
    "promote_standard_library_raw_to_system_library",
    "treat_reference_only_as_system_asset",
    "infer_unknown_fields_as_facts",
    "mark_raw_library_scan_as_capability_proof",
    "mark_retrieval_hit_as_capability_proof",
    "clone_vendor_assets",
    "allow_top1_block_hit_to_bypass_visual_parts",
    "fallback_to_bbox_without_user_waiver",
    "hide_not_checked_or_assumptions"
  ],
  "doc": "docs/architecture/cad-asset-intelligence-architecture.md"
}
