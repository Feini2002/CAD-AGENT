{
  "id": "pipeline_intent",
  "name": "Intent Agent",
  "type": "global_pipeline_agent",
  "role": "白话→结构化意图；参照款先截图视觉分析；尺寸取整写入 brief",
  "inputs": [
    "roundN_context_pack.json",
    "runs/roundN_retrieval_pack.json",
    "runs/roundN_visual_parts.json",
    "runs/roundN_visual_style_brief.md",
    "brief.md",
    "user_dialogue",
    "agents/<scene>/rules.md"
  ],
  "outputs": [
    "runs/roundN_intent.json",
    "expected/audit_checklist.json"
  ],
  "pass_gate": {
    "ready_to_draw": true,
    "open_questions": [],
    "visual_parts_present_for_reference_match": true,
    "visual_style_brief_present": true,
    "retrieval_route_declared": true,
    "target_dimensions_rounded": true
  },
  "sizing_rules": {
    "priority": "visual_over_exact",
    "round_to_mm": [5, 10],
    "examples": {
      "three_seat_to_two_seat_width": "round(ref_width * 2/3, nearest 10mm); do not emit 1866.7"
    },
    "fillet_and_arc": "document approximate range (e.g. R≈30), not exact probe decimals"
  },
  "common_sense_ontology": {
    "sofa_plan": [
      "left_arm",
      "right_arm",
      "seat_cushions",
      "back_cushions",
      "backrest_rail",
      "optional_base_rail"
    ],
    "defaults_unless_user_overrides": "real_world_furniture_parts_not_schematic_box"
  },
  "uses_core": ["plan_engine.validate", "schemas"],
  "must_not": [
    "execute_cad",
    "mark_audit_pass",
    "rewrite_visual_parts_semantics_without_visual_intent_update",
    "skip_visual_analysis_for_style_match_brief",
    "allow_reference_match_without_style_target",
    "emit_bbox_as_object_when_retrieval_route_is_unsupported",
    "emit_sub_mm_targets_from_probe_without_rounding"
  ],
  "doc": "docs/training/vision-first-style.md"
}
