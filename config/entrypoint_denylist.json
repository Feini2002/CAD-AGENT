{
  "schemaVersion": "entrypoint-denylist/v1",
  "denyPatterns": [
    {
      "entrypoint": "scripts/run_cad_foundation_remaining_training.py",
      "requiredArgs": ["--all-31"],
      "deniedArgs": ["--replay-mode", "smoke_replay"],
      "reasonCode": "blocked_all_31_smoke_replay_without_explicit_smoke",
      "message": "--all-31 must not silently run smoke_replay when the operator expects retraining or growth evidence."
    },
    {
      "entrypoint": "scripts/execute_plan.py",
      "argvContains": "--save-current-dwg",
      "reasonCode": "blocked_current_dwg_save_argument",
      "message": "Current business DWG save is not allowed through a generic execute-plan entrypoint."
    },
    {
      "entrypoint": "scripts/reuse_system_asset.py",
      "argvContains": "whole_modelspace",
      "reasonCode": "blocked_imprecise_asset_source_spec",
      "message": "System asset reuse/export must not use whole_modelspace as a source boundary."
    },
    {
      "entrypoint": "scripts/sediment_system_asset.py",
      "argvContains": "training_panel",
      "reasonCode": "blocked_training_panel_asset_source_spec",
      "message": "System asset sedimentation must not use a training panel as a clean reusable source."
    }
  ]
}
