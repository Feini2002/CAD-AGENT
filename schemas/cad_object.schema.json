{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_object.schema.json",
  "title": "CAD_OBJECT",
  "type": "object",
  "required": ["type", "name", "draw_method"],
  "properties": {
    "type": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "default_width": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "default_depth": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "draw_method": {
      "type": "string"
    },
    "default_layer_role": {
      "type": "string"
    }
  },
  "additionalProperties": true
}

