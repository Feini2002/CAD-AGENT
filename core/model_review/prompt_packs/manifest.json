  "plannedPacks": [
    {
      "agentId": "pipeline_visual_intent",
      "taskType": "visual_intent_review",
      "priority": "P1",
      "purpose": "Review reference images, screenshots, style targets, visual parts, proportions, and forbidden simplifications before CAD_PLAN."
    },
    {
      "agentId": "pipeline_intent",
      "taskType": "intent_review",
      "priority": "P1",
      "purpose": "Review plain-language to structured-intent conversion, ambiguity, assumptions, missing dimensions, and evidence boundaries."
    },
    {
      "agentId": "pipeline_audit",
      "taskType": "audit_review",
      "priority": "P1",
      "purpose": "Review machine audit output for hidden visual or semantic failures and promote stronger checker candidates."
    },
    {
      "agentId": "pipeline_asset_dwg_curator",
      "taskType": "asset_dwg_curation_review",
      "priority": "P1",
      "purpose": "Review native system asset DWG layout plans, source/proof separation, shelf readability, and expansion capacity."
    },
    {
      "agentId": "pipeline_context_curator",
      "taskType": "context_curator_review",
      "priority": "P2",
      "purpose": "Review context packs for stale history, missing user feedback, invalid handles, and evidence drift."
    },
    {
      "agentId": "pipeline_asset_retriever",
      "taskType": "asset_retrieval_review",
      "priority": "P2",
      "purpose": "Review retrieval strength and prevent weak matches from being treated as CAD proof."
    },
    {
      "agentId": "pipeline_asset_librarian",
      "taskType": "asset_librarian_review",
      "priority": "P2",
      "purpose": "Review asset taxonomy, naming, dedupe, retrieval tags, lifecycle state, and version conflicts."
    },
    {
      "agentId": "pipeline_asset_reuse_auditor",
      "taskType": "asset_reuse_audit_review",
      "priority": "P2",
      "purpose": "Review whether reuse evidence is plan-only, ready probe, or real replay with created handles/readback."
    },
    {
      "agentId": "pipeline_execute",
      "taskType": "execute_plan_guard_review",
      "priority": "P3",
      "purpose": "Review CAD_PLAN execution risk only; never authorize CAD commands, deletion, saving, or formal-layer edits."
