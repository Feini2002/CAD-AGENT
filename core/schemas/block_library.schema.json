{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block_library.schema.json",
  "title": "BLOCK_LIBRARY",
  "type": "object",
  "required": ["version", "library_id", "blocks"],
  "properties": {
    "version": { "type": "string", "enum": ["0.1", "0.2"] },
    "library_id": { "type": "string" },
    "units": { "type": "string", "enum": ["mm"] },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block_id", "name", "category", "domain", "size", "rotation_allowed"],
        "properties": {
          "block_id": { "type": "string" },
          "block_version": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "domain": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "size": {
            "type": "object",
            "required": ["width", "depth"],
            "properties": {
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "depth": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": false
          },
          "insertion_point": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": { "type": "number" }
          },
          "rotation_allowed": { "type": "boolean" },
          "clearance_mm": { "type": "number", "minimum": 0 },
          "source": { "type": "object" },
          "cad_identity": { "type": "object" },
          "anchor_points": { "type": "object" },
          "footprint_2d": { "type": "object" },
          "clearance_zones": { "type": "array" },
          "connection_points": { "type": "array" },
          "symbol_2d": { "type": "object" },
          "layer_bindings": { "type": "object" },
          "validation": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
