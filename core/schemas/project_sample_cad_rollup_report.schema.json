{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_sample_cad_rollup_report.schema.json",
  "title": "PROJECT_SAMPLE_CAD_ROLLUP_REPORT",
  "type": "object",
  "required": [
    "version",
    "rollup_id",
    "package_id",
    "status",
    "evidence_state",
    "geometry_verified",
    "sample_count",
    "geometry_verified_count",
    "samples",
    "safety"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "rollup_id": { "type": "string" },
    "package_id": { "type": "string" },
    "status": { "type": "string" },
    "evidence_state": { "type": "string" },
    "geometry_verified": { "type": "boolean" },
    "sample_count": { "type": "integer", "minimum": 0 },
    "geometry_verified_count": { "type": "integer", "minimum": 0 },
    "deferred_count": { "type": "integer", "minimum": 0 },
    "failed_count": { "type": "integer", "minimum": 0 },
    "output_dir": { "type": "string" },
    "safety": { "type": "object" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sample_id",
          "status",
          "geometry_verified",
          "created_handle_count"
        ],
        "properties": {
          "sample_id": { "type": "string" },
          "runner": { "type": "string" },
          "status": { "type": "string" },
          "geometry_verified": { "type": "boolean" },
          "evidence_state": { "type": "string" },
          "created_handle_count": { "type": "integer", "minimum": 0 },
          "plan_count": { "type": "integer", "minimum": 0 },
          "report_path": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
