{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layout_proposal.schema.json",
  "title": "LAYOUT_PROPOSAL",
  "type": "object",
  "required": ["version", "layout_id", "project_id", "candidates", "uncertainties"],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "layout_id": { "type": "string" },
    "project_id": { "type": "string" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidate_id", "score", "placements", "checks"],
        "properties": {
          "candidate_id": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "placements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["object_id", "base_point", "bbox"],
              "properties": {
                "object_id": { "type": "string" },
                "base_point": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "number" } },
                "rotation": { "type": "number" },
                "bbox": {
                  "type": "object",
                  "required": ["min", "max"],
                  "properties": {
                    "min": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                    "max": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "checks": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      }
    },
    "uncertainties": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
