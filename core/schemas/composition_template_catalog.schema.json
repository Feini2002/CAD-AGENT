{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "composition_template_catalog.schema.json",
  "title": "COMPOSITION_TEMPLATE_CATALOG",
  "type": "object",
  "required": ["version", "catalog_id", "templates"],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "catalog_id": { "type": "string", "enum": ["composition_templates"] },
    "templates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["name", "domain", "objects"],
        "properties": {
          "name": { "type": "string" },
          "domain": { "type": "string" },
          "objects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["instance_id", "type", "name", "role", "base_point", "size"],
              "properties": {
                "instance_id": { "type": "string" },
                "type": { "type": "string" },
                "name": { "type": "string" },
                "role": { "type": "string" },
                "base_point": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": { "type": "number" }
                },
                "size": {
                  "type": "object",
                  "required": ["width", "depth", "height"],
                  "properties": {
                    "width": { "type": "number", "exclusiveMinimum": 0 },
                    "depth": { "type": "number", "exclusiveMinimum": 0 },
                    "height": { "type": "number", "exclusiveMinimum": 0 }
                  },
                  "additionalProperties": false
                },
                "include_dimensions": { "type": "boolean", "enum": [false] },
                "include_label": { "type": "boolean", "enum": [false] }
              },
              "additionalProperties": false
            }
          },
          "bindings": { "type": "array" },
          "clearance_refs": { "type": "array" },
          "circulation": { "type": "array" },
          "layout_notes": { "type": "array", "items": { "type": "string" } },
          "layout_constraints": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
