{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request_context.schema.json",
  "title": "REQUEST_CONTEXT",
  "type": "object",
  "required": [
    "version",
    "context_id",
    "request_kind",
    "user_request",
    "inputs",
    "cad_policy",
    "clarification"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "context_id": { "type": "string", "minLength": 1 },
    "request_kind": {
      "type": "string",
      "enum": [
        "draw",
        "layout",
        "project_sample",
        "cad_validation",
        "proposal",
        "read_drawing",
        "general"
      ]
    },
    "user_request": { "type": "string" },
    "scene_hint": { "type": "string" },
    "project_manifest": {
      "type": "object",
      "properties": {
        "manifest_path": { "type": "string" },
        "project_id": { "type": "string" },
        "scene_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "design_brief",
              "object_spec",
              "cad_plan",
              "project_sample_manifest",
              "shell_model",
              "project_model",
              "block_library",
              "layout_proposal",
              "design_proposal"
            ]
          }
        },
        "paths": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "cad_policy": {
      "type": "object",
      "required": ["allow_cad", "preview_only"],
      "properties": {
        "allow_cad": { "type": "boolean" },
        "preview_only": { "type": "boolean" },
        "cad_environment_available": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "clarification": {
      "type": "object",
      "required": ["needs_clarification"],
      "properties": {
        "needs_clarification": { "type": "boolean" },
        "questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
