{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RETRIEVAL_PACK",
  "type": "object",
  "required": [
    "schema_version",
    "retrieval_id",
    "brief",
    "scene",
    "route",
    "matched_assets",
    "object_family",
    "archetype",
    "required_parts",
    "allowed_render_tiers",
    "known_failures",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "retrieval_id": { "type": "string" },
    "brief": { "type": "string" },
    "scene": { "type": "string" },
    "case_id": { "type": "string" },
    "route": {
      "type": "string",
      "enum": ["exact_reuse", "parametric_variant", "semantic_redraw", "novel_with_constraints", "unsupported_or_risky"]
    },
    "matched_assets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "object_family": { "type": "string" },
    "archetype": { "type": "string" },
    "required_parts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_render_tiers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "known_failures": {
      "type": "array",
      "items": { "type": "object" }
    },
    "evidence_boundary": {
      "type": "object",
      "required": ["checked", "not_checked", "assumptions"],
      "properties": {
        "checked": {
          "type": "array",
          "items": { "type": "string" }
        },
        "not_checked": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
