{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "placement_resolution.schema.json",
  "title": "PLACEMENT_RESOLUTION",
  "type": "object",
  "required": ["status", "phrase", "checked", "not_checked", "assumptions"],
  "properties": {
    "status": {"type": "string", "enum": ["resolved", "needs_confirmation", "blocked"]},
    "phrase": {"type": "string"},
    "phrase_analysis": {
      "type": "object",
      "properties": {
        "raw": {"type": "string"},
        "relation": {"type": "string"},
        "direction_bias": {"type": ["string", "null"]},
        "matched_tokens": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number"}
      },
      "additionalProperties": true
    },
    "viewport_bbox_before_draw": {"type": "object"},
    "anchor_source": {"type": "string"},
    "anchor_confidence": {"type": "number"},
    "anchor_handles": {"type": "array", "items": {"type": "string"}},
    "anchor_candidates": {"type": "array"},
    "anchor_bbox": {"type": "object"},
    "candidate_slots": {"type": "array"},
    "selected_slot": {"type": "object"},
    "base_point": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "target_bbox_expected": {"type": "object"},
    "checks": {"type": "object"},
    "checked": {"type": "array", "items": {"type": "string"}},
    "not_checked": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "blocked_reasons": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
