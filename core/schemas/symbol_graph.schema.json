{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "symbol_graph.schema.json",
  "title": "SYMBOL_GRAPH",
  "type": "object",
  "required": ["version", "graph_id", "view", "nodes"],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "graph_id": { "type": "string" },
    "view": { "type": "string", "enum": ["plan", "elevation"] },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "symbol_id", "placement"],
        "properties": {
          "node_id": { "type": "string" },
          "symbol_id": { "type": "string" },
          "symbol_spec_path": { "type": "string" },
          "placement": {
            "type": "object",
            "required": ["base_point", "rotation_deg"],
            "properties": {
              "base_point": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": { "type": "number" }
              },
              "rotation_deg": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "from_node_id", "to_node_id", "relation"],
        "properties": {
          "edge_id": { "type": "string" },
          "from_node_id": { "type": "string" },
          "to_node_id": { "type": "string" },
          "relation": {
            "type": "string",
            "enum": ["faces", "aligned_with", "clearance_to", "grouped_with"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
