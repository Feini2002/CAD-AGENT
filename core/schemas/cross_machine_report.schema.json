{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cross_machine_report.schema.json",
  "title": "CROSS_MACHINE_REPORT",
  "type": "object",
  "required": [
    "version",
    "package_id",
    "status",
    "generated_at",
    "machine",
    "no_cad_steps",
    "coverage_recalc",
    "user_gate",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "package_id": { "type": "string" },
    "status": { "type": "string", "enum": ["pass", "fail", "blocked"] },
    "generated_at": { "type": "string" },
    "machine": {
      "type": "object",
      "required": ["platform", "python_version", "cad_mcp_venv_present"],
      "properties": {
        "platform": { "type": "string" },
        "python_version": { "type": "string" },
        "cad_mcp_venv_present": { "type": "boolean" },
        "project_root": { "type": "string" }
      }
    },
    "no_cad_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "title", "status"],
        "properties": {
          "step_id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skipped"] }
        }
      }
    },
    "coverage_recalc": {
      "type": "object",
      "required": [
        "status",
        "baseline_path",
        "current_path",
        "baseline_headline_percent",
        "current_headline_percent"
      ],
      "properties": {
        "status": { "type": "string" },
        "baseline_path": { "type": "string" },
        "current_path": { "type": "string" },
        "baseline_headline_percent": { "type": "number" },
        "current_headline_percent": { "type": "number" },
        "headline_delta_percent": { "type": "number" },
        "total_count_delta": { "type": "integer" }
      }
    },
    "user_gate": {
      "type": "object",
      "required": ["status", "pending_steps"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "acknowledged"] },
        "pending_steps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "human_runbook_path": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["no_cad_pass_count", "no_cad_fail_count"],
      "properties": {
        "no_cad_pass_count": { "type": "integer", "minimum": 0 },
        "no_cad_fail_count": { "type": "integer", "minimum": 0 }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
