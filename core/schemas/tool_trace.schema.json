{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "toolIntentId",
    "requestedByAgentId",
    "toolName",
    "toolSchemaVersion",
    "riskLevel",
    "permissionClass",
    "targetScope",
    "orchestratorDecision",
    "blockingReasons",
    "deterministicEntryPoint",
    "executionStatus",
    "resultStatus",
    "result",
    "expectedEvidence",
    "evidenceBoundary",
    "downstreamReadableSummary",
    "downstreamArtifactPath",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "runId": { "type": "string" },
    "toolIntentId": { "type": "string" },
    "requestedByAgentId": { "type": "string" },
    "toolName": { "type": "string" },
    "toolSchemaVersion": { "type": "string" },
    "riskLevel": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
    "permissionClass": { "type": "string" },
    "targetScope": { "type": "object" },
    "orchestratorDecision": { "type": "string", "enum": ["allowed", "blocked", "needs_more_evidence"] },
    "blockingReasons": { "type": "array", "items": { "type": "string" } },
    "deterministicEntryPoint": { "type": "string" },
    "executionStatus": {
      "type": "string",
      "enum": ["allowed_not_executed", "blocked_before_execution", "not_executed", "executed", "failed"]
    },
    "resultStatus": {
      "type": "string"
    },
    "result": { "type": "object" },
    "expectedEvidence": { "type": "array", "items": { "type": "string" } },
    "evidenceBoundary": { "type": "array", "items": { "type": "string" } },
    "downstreamReadableSummary": { "type": "string" },
    "downstreamArtifactPath": { "type": "string" },
    "generatedAt": { "type": "string" }
  }
}
