{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "confirmed_cad_plan_bundle.schema.json",
  "title": "CONFIRMED_CAD_PLAN_BUNDLE",
  "type": "object",
  "required": [
    "version",
    "proposal_id",
    "confirmation_id",
    "confirmed_candidate_id",
    "controlled_cad_policy",
    "confirmed_cad_plans",
    "unselected_candidate_evidence",
    "validation",
    "dry_run"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "proposal_id": { "type": "string" },
    "confirmation_id": { "type": "string" },
    "confirmed_candidate_id": { "type": "string" },
    "controlled_cad_policy": {
      "type": "object",
      "required": ["layer", "needs_confirmation", "saved_dwg"],
      "properties": {
        "layer": { "type": "string" },
        "needs_confirmation": { "type": "boolean" },
        "saved_dwg": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "confirmed_cad_plans": { "type": "array", "minItems": 1 },
    "unselected_candidate_evidence": { "type": "object" },
    "validation": { "type": "object" },
    "dry_run": { "type": "object" }
  },
  "additionalProperties": false
}
