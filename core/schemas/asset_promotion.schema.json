{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASSET_PROMOTION",
  "type": "object",
  "required": ["id", "candidate_ref", "decision", "gates_passed", "evidence_refs"],
  "properties": {
    "id": { "type": "string" },
    "candidate_ref": { "type": "string" },
    "promoted_to": { "type": "string" },
    "decision": {
      "type": "string",
      "enum": ["promoted", "rejected", "needs_more_evidence"]
    },
    "target_status": {
      "type": "string",
      "enum": ["candidate", "case_verified", "system_verified", "deprecated"]
    },
    "gates_passed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reviewer": { "type": "string" },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
