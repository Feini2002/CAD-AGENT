{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposal_candidate_scoring.schema.json",
  "title": "PROPOSAL_CANDIDATE_SCORING",
  "type": "object",
  "required": ["version", "rank", "base_score", "scene_weight", "weighted_score", "weight_source", "components"],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "rank": { "type": "integer", "minimum": 1 },
    "base_score": { "type": "number" },
    "scene_weight": { "type": "number" },
    "weighted_score": { "type": "number" },
    "weight_source": { "type": "string" },
    "components": {
      "type": "object",
      "required": ["layout_base", "check_penalty", "preference_boost"],
      "properties": {
        "layout_base": { "type": "number" },
        "check_penalty": { "type": "number" },
        "preference_boost": { "type": "number" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
