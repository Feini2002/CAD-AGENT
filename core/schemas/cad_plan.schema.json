{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_plan.schema.json",
  "title": "CAD_PLAN",
  "type": "object",
  "required": [
    "version",
    "domain",
    "intent",
    "object",
    "placement",
    "drawing",
    "confidence",
    "needs_confirmation"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["0.1"]
    },
    "domain": {
      "type": "string",
      "enum": ["generic", "residential", "retail", "office", "restaurant", "commercial_fitout", "exhibition", "hotel", "education", "healthcare", "industrial", "custom"]
    },
    "intent": {
      "type": "string",
      "enum": ["draw_object", "draw_symbol_glyph", "draw_annotation", "modify_object", "delete_object", "insert_block_alpha"]
    },
    "object": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "block_id": {
          "type": "string"
        },
        "cad_identity": {
          "type": "object"
        },
        "attributes": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "placement": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["absolute", "space_reference", "relative_to_object"]
        },
        "base_point": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "space": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "rotation": {
          "type": "number"
        },
        "scale": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "additionalProperties": true
    },
    "drawing": {
      "type": "object",
      "required": ["layer"],
      "properties": {
        "layer": {
          "type": "string"
        },
        "include_label": {
          "type": "boolean"
        },
        "include_dimensions": {
          "type": "boolean"
        },
        "layer_role": {
          "type": "string"
        },
        "semantic_layer": {
          "type": "string"
        },
        "style_token": {
          "type": "string"
        },
        "style_role": {
          "type": "string"
        },
        "style_resolution": {
          "type": "object",
          "properties": {
            "source_profile_id": { "type": "string" },
            "style_token": { "type": "string" },
            "style_role": { "type": "string" },
            "layer_role": { "type": "string" },
            "semantic_layer": { "type": "string" },
            "resolved_layer": { "type": "string" },
            "lineweight_mm": { "type": "number" },
            "resolved_cad_lineweight": { "type": "integer" },
            "linetype": { "type": "string" },
            "linetype_scale": { "type": "number" },
            "color_policy": { "type": "string" },
            "color": {},
            "inheritance_mode": { "type": "string" },
            "evidence_boundary": { "type": "object" }
          },
          "additionalProperties": true
        },
        "entity_style_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "part_ref": { "type": "string" },
              "primitive_role": { "type": "string" },
              "style_token": { "type": "string" },
              "override_reason": { "type": "string" },
              "handle_ref_after_execution": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "style_assumptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_confirmation": {
      "type": "boolean"
    },
    "drawing_standard_profile_id": {
      "type": "string"
    },
    "object_role": {
      "type": "string"
    },
    "drawing_standard_resolution": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["placement"],
        "properties": {
          "placement": {
            "required": ["mode"],
            "properties": {
              "mode": {
                "const": "absolute"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "placement": {
            "required": ["base_point"]
          }
        }
      }
    }
  ]
}
