{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shell_drawing_read_confirmation.schema.json",
  "title": "SHELL_DRAWING_READ_CONFIRMATION",
  "type": "object",
  "required": [
    "version",
    "confirmation_id",
    "report_ref",
    "action",
    "confirmed_items",
    "overrides",
    "notes"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "confirmation_id": { "type": "string" },
    "report_ref": {
      "type": "object",
      "required": ["shell_candidate_id"],
      "properties": {
        "shell_candidate_id": { "type": "string" },
        "source_fixture": { "type": "string" }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "string",
      "enum": ["accept", "accept_with_risks", "reject"]
    },
    "confirmed_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "status"],
        "properties": {
          "item_id": { "type": "string" },
          "status": { "type": "string", "enum": ["confirmed", "skipped", "rejected"] },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "overrides": {
      "type": "object",
      "required": ["shell_id", "excluded_draft_ids"],
      "properties": {
        "shell_id": { "type": "string" },
        "boundary": { "type": "object" },
        "openings": { "type": "array" },
        "fixed_obstacles": { "type": "array" },
        "no_place_zones": { "type": "array" },
        "excluded_draft_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "confirmed_by": { "type": "string" },
    "confirmed_at": { "type": "string" }
  },
  "additionalProperties": false
}
