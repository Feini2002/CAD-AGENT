{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "symbol_spec.schema.json",
  "title": "SYMBOL_SPEC",
  "type": "object",
  "required": [
    "version",
    "symbol_id",
    "object_type",
    "archetype",
    "view",
    "footprint",
    "orientation",
    "parts",
    "readability_constraints",
    "fallback_policy"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "symbol_id": { "type": "string" },
    "object_type": {
      "type": "string",
      "enum": [
        "table",
        "desk",
        "chair",
        "sofa",
        "bed",
        "cabinet",
        "shelf",
        "counter",
        "display_unit",
        "workstation",
        "block_reference"
      ]
    },
    "archetype": {
      "type": "string",
      "enum": ["surface", "seating", "sleeping", "storage", "display", "workstation"]
    },
    "view": { "type": "string", "enum": ["plan", "elevation"] },
    "footprint": {
      "type": "object",
      "required": ["width_mm", "depth_mm"],
      "properties": {
        "width_mm": { "type": "number", "exclusiveMinimum": 0 },
        "depth_mm": { "type": "number", "exclusiveMinimum": 0 },
        "height_mm": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "orientation": {
      "type": "object",
      "required": ["rotation_deg"],
      "properties": {
        "rotation_deg": { "type": "number" },
        "facing": {
          "type": "string",
          "enum": ["north", "east", "south", "west", "unspecified"]
        }
      },
      "additionalProperties": false
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["part_id", "kind"],
        "properties": {
          "part_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "outline",
              "inner_offset",
              "thick_band",
              "split_line",
              "leg_marker",
              "arc_marker",
              "seat_split",
              "drawer_line",
              "door_swing",
              "clearance_ghost",
              "orientation_marker"
            ]
          },
          "role": { "type": "string" },
          "params": {
            "type": "object",
            "properties": {
              "offset_mm": { "type": "number" },
              "inset_mm": { "type": "number" },
              "band_width_mm": { "type": "number" },
              "line_spacing_mm": { "type": "number" },
              "marker_size_mm": { "type": "number" },
              "span_ratio": { "type": "number" },
              "axis": { "type": "string", "enum": ["x", "y"] }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "readability_constraints": {
      "type": "object",
      "required": ["min_part_count", "requires_non_bbox_parts", "allows_text_labels", "allows_dimensions"],
      "properties": {
        "min_part_count": { "type": "integer", "minimum": 1 },
        "requires_non_bbox_parts": { "type": "boolean" },
        "allows_text_labels": { "type": "boolean" },
        "allows_dimensions": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "fallback_policy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "block_preferred",
            "symbol_readable",
            "visual_review_required",
            "fallback_component_preview",
            "fallback_bbox_placeholder",
            "deferred_unsupported_symbol"
          ]
        },
        "reason": { "type": "string" },
        "bbox_fallback_declared": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source_object_id": { "type": "string" },
        "mapping_status": {
          "type": "string",
          "enum": ["symbol_mapped", "fallback_explicit", "deferred"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
