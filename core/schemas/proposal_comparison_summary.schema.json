{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposal_comparison_summary.schema.json",
  "title": "PROPOSAL_COMPARISON_SUMMARY",
  "type": "object",
  "required": [
    "version",
    "object_coverage",
    "circulation",
    "conflicts",
    "failure_reasons",
    "ranking_reason_codes",
    "narrative"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "object_coverage": {
      "type": "object",
      "required": ["requested_types", "placed_types", "coverage_rate", "placed_count", "placement_count"],
      "properties": {
        "requested_types": { "type": "array", "items": { "type": "string" } },
        "placed_types": { "type": "array", "items": { "type": "string" } },
        "coverage_rate": { "type": "number" },
        "placed_count": { "type": "integer" },
        "placement_count": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "circulation": {
      "type": "object",
      "required": ["continuity", "selected_strategy", "blocked_strategies", "branch_count"],
      "properties": {
        "continuity": { "type": "string" },
        "selected_strategy": { "type": "string" },
        "blocked_strategies": { "type": "array", "items": { "type": "string" } },
        "branch_count": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "conflicts": {
      "type": "object",
      "required": ["failed_check_count", "layout_failed_checks", "placement_failed_count"],
      "properties": {
        "failed_check_count": { "type": "integer" },
        "layout_failed_checks": { "type": "array", "items": { "type": "string" } },
        "placement_failed_count": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "failure_reasons": {
      "type": "object",
      "required": ["all_distribution", "selected_distribution"],
      "properties": {
        "all_distribution": { "type": "object" },
        "selected_distribution": { "type": "object" }
      },
      "additionalProperties": false
    },
    "ranking_reason_codes": { "type": "array", "items": { "type": "string" } },
    "narrative": { "type": "string" }
  },
  "additionalProperties": false
}
