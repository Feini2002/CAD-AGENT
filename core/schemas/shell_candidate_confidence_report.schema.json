{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shell_candidate_confidence_report.schema.json",
  "title": "SHELL_CANDIDATE_CONFIDENCE_REPORT",
  "type": "object",
  "required": [
    "version",
    "read_only",
    "source",
    "confidence",
    "shell_candidate_draft",
    "gaps",
    "human_confirmation_items",
    "ready_for_human_confirmation_file"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "read_only": { "type": "boolean" },
    "source": { "type": "object" },
    "geometry_candidates_ref": { "type": "object" },
    "confidence": {
      "type": "object",
      "required": ["overall", "boundary", "openings", "fixed_obstacles", "no_place_zones"],
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 1 },
        "boundary": { "type": "number", "minimum": 0, "maximum": 1 },
        "openings": { "type": "number", "minimum": 0, "maximum": 1 },
        "fixed_obstacles": { "type": "number", "minimum": 0, "maximum": 1 },
        "no_place_zones": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "shell_candidate_draft": { "type": "object" },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "severity"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "severity": { "type": "string", "enum": ["warning", "blocker"] }
        },
        "additionalProperties": false
      }
    },
    "human_confirmation_items": { "type": "array" },
    "ready_for_human_confirmation_file": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
