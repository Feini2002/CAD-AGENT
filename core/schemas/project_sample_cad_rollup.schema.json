{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_sample_cad_rollup.schema.json",
  "title": "PROJECT_SAMPLE_CAD_ROLLUP_MANIFEST",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rollup_id", "package_id", "preview_layer", "samples"],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "rollup_id": { "type": "string" },
    "package_id": { "type": "string", "const": "LCAD-08-PROJECT-SAMPLE-CAD" },
    "preview_layer": { "type": "string", "const": "CODEX_PREVIEW" },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["sample_id", "runner", "workflow_path", "cad_offset", "report_filename"],
        "properties": {
          "sample_id": { "type": "string" },
          "runner": {
            "type": "string",
            "enum": ["blank_shell_workflow", "fitout_confirmation_workflow"]
          },
          "workflow_path": { "type": "string" },
          "cad_offset": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": { "type": "number" }
          },
          "report_filename": { "type": "string" }
        }
      }
    }
  }
}
