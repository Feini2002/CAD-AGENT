{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_view_context.schema.json",
  "title": "CAD_VIEW_CONTEXT",
  "type": "object",
  "required": ["unit", "preview_layer", "viewport_bbox", "visible_entities_summary"],
  "properties": {
    "unit": {"type": "string", "enum": ["mm"]},
    "preview_layer": {"type": "string"},
    "viewport_bbox": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "max": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
      },
      "additionalProperties": false
    },
    "selected_handles": {"type": "array", "items": {"type": "string"}},
    "recent_created_handles": {"type": "array", "items": {"type": "string"}},
    "visible_entities_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["handle", "layer", "bbox"],
        "properties": {
          "handle": {"type": "string"},
          "type": {"type": "string"},
          "layer": {"type": "string"},
          "bbox": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {
              "min": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
              "max": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "preview_entities_summary": {"type": "array"},
    "capture_policy": {"type": "object"}
  },
  "additionalProperties": true
}
