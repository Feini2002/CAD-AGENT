{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_regression_manifest.schema.json",
  "title": "PROJECT_REGRESSION_MANIFEST",
  "type": "object",
  "required": ["version", "manifest_id", "package_id", "projects_root", "minimum_sample_count", "samples"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "manifest_id": { "type": "string", "minLength": 1 },
    "package_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "projects_root": { "type": "string", "minLength": 1 },
    "minimum_sample_count": { "type": "integer", "minimum": 2 },
    "cad_regression_rollup_path": { "type": "string" },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "sample_id",
          "sample_root",
          "manifest_path",
          "domain",
          "deidentified",
          "evidence_claim",
          "submittable"
        ],
        "additionalProperties": false,
        "properties": {
          "sample_id": { "type": "string", "minLength": 1 },
          "sample_root": { "type": "string", "minLength": 1 },
          "manifest_path": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string" },
          "domain": { "type": "string" },
          "deidentified": { "type": "boolean" },
          "evidence_claim": {
            "type": "string",
            "enum": ["non_cad_pipeline_only", "non_cad_with_optional_cad_preview"]
          },
          "submittable": { "type": "boolean" },
          "in_cad_regression_rollup": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
