{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drawing_standard_profile.schema.json",
  "title": "DRAWING_STANDARD_PROFILE",
  "type": "object",
  "required": [
    "profile_id",
    "schema_version",
    "units",
    "domain",
    "layer_preset_id",
    "object_role_bindings",
    "block_layer_policy",
    "verification_policy"
  ],
  "properties": {
    "profile_id": { "type": "string" },
    "schema_version": { "type": "string", "enum": ["0.1"] },
    "units": { "type": "string", "enum": ["mm"] },
    "domain": { "type": "string" },
    "layer_preset_id": { "type": "string" },
    "text_styles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["font", "height_mm"],
        "properties": {
          "font": { "type": "string" },
          "height_mm": { "type": "number", "exclusiveMinimum": 0 },
          "width_factor": { "type": "number" },
          "align": { "type": "string" },
          "line_spacing": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "dim_styles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["text_height_mm", "precision"],
        "properties": {
          "text_height_mm": { "type": "number", "exclusiveMinimum": 0 },
          "arrow_size_mm": { "type": "number", "exclusiveMinimum": 0 },
          "precision": { "type": "integer", "minimum": 0 },
          "unit_suffix": { "type": "string" },
          "offset_mm": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "hatch_styles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["pattern"],
        "properties": {
          "pattern": { "type": "string" },
          "scale": { "type": "number" },
          "angle": { "type": "number" },
          "color": { "type": "string" },
          "transparency": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "style_tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["style_role", "layer_role", "lineweight_mm", "linetype", "color_policy", "inheritance_mode"],
        "properties": {
          "style_role": { "type": "string" },
          "layer_role": { "type": "string" },
          "lineweight_mm": { "type": "number", "minimum": 0 },
          "linetype": { "type": "string" },
          "linetype_scale": { "type": "number", "exclusiveMinimum": 0 },
          "color_policy": { "type": "string", "enum": ["by_layer", "by_block", "aci", "truecolor", "plot_style"] },
          "color": { "type": ["string", "integer", "array"] },
          "inheritance_mode": { "type": "string", "enum": ["by_layer", "by_block", "entity_override"] },
          "description": { "type": "string" },
          "evidence_boundary": {
            "type": "object",
            "properties": {
              "checked": {
                "type": "array",
                "items": { "type": "string" }
              },
              "not_checked": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "object_role_bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["layer_role"],
        "properties": {
          "layer_role": { "type": "string" },
          "text_style_id": { "type": "string" },
          "dim_style_id": { "type": "string" },
          "hatch_style_id": { "type": "string" },
          "style_token_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "block_layer_policy": {
      "type": "object",
      "required": ["cad_execution_mode", "preview_layer", "allow_formal_layers"],
      "properties": {
        "cad_execution_mode": { "type": "string", "enum": ["preview_only", "formal_allowed"] },
        "preview_layer": { "type": "string" },
        "allow_formal_layers": { "type": "boolean" },
        "insert_layer_role_default": { "type": "string" },
        "block_internal_layer_role": { "type": "string" }
      },
      "additionalProperties": false
    },
    "verification_policy": {
      "type": "object",
      "required": ["require_layer_role_resolution"],
      "properties": {
        "require_layer_role_resolution": { "type": "boolean" },
        "screenshot_role": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
