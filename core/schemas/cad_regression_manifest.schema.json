{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_regression_manifest.schema.json",
  "title": "CAD_REGRESSION_MANIFEST",
  "type": "object",
  "required": [
    "version",
    "suite_id",
    "description",
    "safety",
    "cases"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "suite_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "safety": {
      "type": "object",
      "required": [
        "layer",
        "saved_dwg",
        "deleted_entities",
        "modified_formal_layers"
      ],
      "properties": {
        "layer": { "type": "string", "enum": ["CODEX_PREVIEW"] },
        "saved_dwg": { "type": "boolean" },
        "deleted_entities": { "type": "boolean" },
        "modified_formal_layers": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "entrypoint",
          "requires_real_cad",
          "expected_evidence_state",
          "output_path",
          "command",
          "safety"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "entrypoint": { "type": "string", "minLength": 1 },
          "requires_real_cad": { "type": "boolean" },
          "expected_evidence_state": {
            "type": "string",
            "enum": [
              "pass",
              "deferred_cad_readback_required",
              "geometry_verified",
              "readback_geometry_verified"
            ]
          },
          "output_path": { "type": "string", "minLength": 1 },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "prerequisites": {
            "type": "array",
            "items": { "type": "string" }
          },
          "safety": {
            "type": "object",
            "required": [
              "layer",
              "saved_dwg",
              "deleted_entities",
              "modified_formal_layers"
            ],
            "properties": {
              "layer": { "type": "string", "enum": ["CODEX_PREVIEW"] },
              "saved_dwg": { "type": "boolean" },
              "deleted_entities": { "type": "boolean" },
              "modified_formal_layers": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
