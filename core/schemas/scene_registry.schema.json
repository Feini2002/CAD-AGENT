{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene_registry.schema.json",
  "title": "SCENE_REGISTRY",
  "type": "object",
  "required": ["version", "registry_id", "default_scene_id", "scenes"],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "registry_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "default_scene_id": { "type": "string", "minLength": 1 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "display_name",
          "maturity",
          "trigger_terms",
          "capabilities",
          "may_bypass_core"
        ],
        "properties": {
          "scene_id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string" },
          "maturity": {
            "type": "string",
            "enum": ["core_only", "scene_alpha", "scene_beta", "scene_product", "scaffold"]
          },
          "description": { "type": "string" },
          "trigger_terms": {
            "type": "array",
            "items": { "type": "string" }
          },
          "capabilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "disabled_conditions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "agent_dir": { "type": "string" },
          "preferences_path": { "type": "string" },
          "scope_path": { "type": "string" },
          "workflows": {
            "type": "array",
            "items": { "type": "string" }
          },
          "auto_activate": { "type": "boolean" },
          "may_bypass_core": { "type": "boolean" },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
