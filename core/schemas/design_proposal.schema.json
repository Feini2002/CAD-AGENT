{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design_proposal.schema.json",
  "title": "DESIGN_PROPOSAL",
  "type": "object",
  "required": ["version", "proposal_id", "brief_id", "project_id", "summary", "decisions", "evidence", "candidates", "confirmed_candidate_id", "comparison_summary", "needs_confirmation", "next_cad_plans"],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "proposal_id": { "type": "string" },
    "brief_id": { "type": "string" },
    "project_id": { "type": "string" },
    "summary": { "type": "string" },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "object",
      "required": ["from_user", "from_drawing", "from_shell", "from_library", "from_algorithm", "inferred"],
      "properties": {
        "from_user": { "type": "array", "items": { "type": "string" } },
        "from_drawing": { "type": "array", "items": { "type": "string" } },
        "from_shell": { "type": "array", "items": { "type": "string" } },
        "from_library": { "type": "array", "items": { "type": "string" } },
        "from_algorithm": { "type": "array", "items": { "type": "string" } },
        "inferred": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "layout_candidate_id", "score", "summary", "strengths", "risks", "failed_checks", "applicable_scenarios", "confirmation_questions", "score_breakdown", "ranking_reasons"],
        "properties": {
          "candidate_id": { "type": "string" },
          "layout_candidate_id": { "type": "string" },
          "score": { "type": "number" },
          "summary": { "type": "string" },
          "strengths": { "type": "array", "items": { "type": "string" } },
          "risks": { "type": "array", "items": { "type": "string" } },
          "failed_checks": { "type": "array", "items": { "type": "string" } },
          "applicable_scenarios": { "type": "array", "items": { "type": "string" } },
          "confirmation_questions": { "type": "array", "items": { "type": "string" } },
          "score_breakdown": {
            "type": "object",
            "required": ["version", "rank", "base_score", "scene_weight", "weighted_score", "weight_source", "components"],
            "properties": {
              "version": { "type": "string", "enum": ["0.1"] },
              "rank": { "type": "integer", "minimum": 1 },
              "base_score": { "type": "number" },
              "scene_weight": { "type": "number" },
              "weighted_score": { "type": "number" },
              "weight_source": { "type": "string" },
              "components": {
                "type": "object",
                "required": ["layout_base", "check_penalty", "preference_boost"],
                "properties": {
                  "layout_base": { "type": "number" },
                  "check_penalty": { "type": "number" },
                  "preference_boost": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "ranking_reasons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" },
                "component": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "confirmed_candidate_id": { "type": "string" },
    "user_confirmation": { "type": "object" },
    "comparison_summary": { "type": "string" },
    "proposal_comparison_summary": {
      "type": "object",
      "required": [
        "version",
        "object_coverage",
        "circulation",
        "conflicts",
        "failure_reasons",
        "ranking_reason_codes",
        "narrative"
      ],
      "properties": {
        "version": { "type": "string", "enum": ["0.1"] },
        "object_coverage": { "type": "object" },
        "circulation": { "type": "object" },
        "conflicts": { "type": "object" },
        "failure_reasons": { "type": "object" },
        "ranking_reason_codes": { "type": "array", "items": { "type": "string" } },
        "narrative": { "type": "string" }
      },
      "additionalProperties": false
    },
    "comparison_detail": {
      "type": "object",
      "required": ["version", "layout_comparison", "selected", "metrics", "circulation_continuity", "ranking_reasons", "ranked_circulation_branches", "narrative"],
      "properties": {
        "version": { "type": "string", "enum": ["0.1"] },
        "layout_comparison": { "type": "object" },
        "selected": { "type": "object" },
        "metrics": { "type": "object" },
        "circulation_continuity": { "type": "object" },
        "ranking_reasons": { "type": "array", "items": { "type": "string" } },
        "ranked_circulation_branches": { "type": "array", "items": { "type": "object" } },
        "narrative": { "type": "string" }
      },
      "additionalProperties": false
    },
    "needs_confirmation": { "type": "boolean" },
    "next_cad_plans": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
