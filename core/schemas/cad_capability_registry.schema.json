{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_capability_registry.schema.json",
  "title": "CAD_CAPABILITY_REGISTRY",
  "type": "object",
  "required": ["version", "registry_id", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "registry_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "updated_at": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "display_name",
          "category",
          "claim_level",
          "ladder_level"
        ],
        "additionalProperties": false,
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 3
          },
          "display_name": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": [
              "intent",
              "primitive",
              "object",
              "symbol",
              "block",
              "composition",
              "micro_scene",
              "blank_shell",
              "workflow",
              "scene",
              "project_sample",
              "drawing_read",
              "other"
            ]
          },
          "claim_level": {
            "type": "string",
            "enum": ["none", "deferred", "smoke", "verified", "showcase"]
          },
          "ladder_level": {
            "type": "string",
            "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]
          },
          "domain": {
            "type": "string",
            "enum": [
              "generic",
              "residential",
              "retail",
              "office",
              "restaurant",
              "commercial_fitout",
              "exhibition",
              "hotel",
              "education",
              "healthcare",
              "industrial",
              "custom"
            ]
          },
          "intent": { "type": "string", "minLength": 1 },
          "object_type": { "type": "string", "minLength": 1 },
          "symbol_archetype": { "type": "string", "minLength": 1 },
          "readability_status": {
            "type": "string",
            "enum": [
              "symbol_readable",
              "visual_review_required",
              "fallback_component_preview",
              "fallback_bbox_placeholder",
              "deferred_unsupported_symbol"
            ]
          },
          "composition_id": { "type": "string", "minLength": 1 },
          "scene_id": { "type": "string", "minLength": 1 },
          "deferred_reason": { "type": "string", "minLength": 1 },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_kind", "source_path"],
              "additionalProperties": false,
              "properties": {
                "source_kind": {
                  "type": "string",
                  "enum": [
                    "cad_plan",
                    "object_catalog",
                    "block_library",
                    "benchmark",
                    "regression_manifest",
                    "rcad",
                    "documentation",
                    "manual"
                  ]
                },
                "source_path": { "type": "string", "minLength": 1 },
                "source_key": { "type": "string", "minLength": 1 }
              }
            }
          },
          "cad_case": {
            "type": "object",
            "required": ["case_kind"],
            "additionalProperties": false,
            "properties": {
              "case_kind": {
                "type": "string",
                "enum": [
                  "none",
                  "cad_plan",
                  "benchmark_case",
                  "regression_manifest_case",
                  "script",
                  "workflow"
                ]
              },
              "plan_path": { "type": "string", "minLength": 1 },
              "benchmark_suite_path": { "type": "string", "minLength": 1 },
              "benchmark_case_id": { "type": "string", "minLength": 1 },
              "manifest_path": { "type": "string", "minLength": 1 },
              "manifest_case_id": { "type": "string", "minLength": 1 },
              "workflow_id": { "type": "string", "minLength": 1 },
              "entrypoint": { "type": "string", "minLength": 1 },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "output_path": { "type": "string", "minLength": 1 },
              "requires_real_cad": { "type": "boolean" },
              "safety": {
                "type": "object",
                "required": [
                  "layer",
                  "saved_dwg",
                  "deleted_entities",
                  "modified_formal_layers"
                ],
                "additionalProperties": false,
                "properties": {
                  "layer": { "type": "string", "enum": ["CODEX_PREVIEW"] },
                  "saved_dwg": { "type": "boolean" },
                  "deleted_entities": { "type": "boolean" },
                  "modified_formal_layers": { "type": "boolean" }
                }
              }
            }
          },
          "evidence": {
            "type": "object",
            "required": ["evidence_state", "geometry_accuracy", "screenshot_role"],
            "additionalProperties": false,
            "properties": {
              "evidence_state": {
                "type": "string",
                "enum": [
                  "cad_capability_verified",
                  "readback_geometry_verified",
                  "deferred_cad_readback_required",
                  "benchmark_pass_non_cad",
                  "blocked_expected_non_cad",
                  "dry_run_valid_plan_only",
                  "invalid_configuration",
                  "negative_guard_verified"
                ]
              },
              "geometry_accuracy": {
                "type": "string",
                "enum": [
                  "verified_by_cad_readback",
                  "verified_by_cad_capability_readback",
                  "not_verified_without_cad_readback",
                  "not_verified_by_screenshot"
                ]
              },
              "screenshot_role": {
                "type": "string",
                "enum": ["visual_aid_only", "not_applicable"]
              },
              "report_path": { "type": "string", "minLength": 1 },
              "last_verified_at": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
