{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability_lab_report.schema.json",
  "title": "CAPABILITY_LAB_REPORT",
  "type": "object",
  "required": [
    "version",
    "package_id",
    "tier",
    "status",
    "generated_at",
    "requires_real_cad",
    "output_root",
    "steps",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "package_id": { "type": "string" },
    "tier": { "type": "string" },
    "status": { "type": "string", "enum": ["pass", "fail", "blocked"] },
    "generated_at": { "type": "string" },
    "requires_real_cad": { "type": "boolean" },
    "output_root": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "title", "status"],
        "additionalProperties": true,
        "properties": {
          "step_id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skipped", "dry_run"] },
          "exit_code": { "type": "integer" },
          "command": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["step_count", "passed_count", "failed_count"],
      "additionalProperties": false,
      "properties": {
        "step_count": { "type": "integer", "minimum": 1 },
        "passed_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "cad_strength_headline_percent": { "type": "number" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
