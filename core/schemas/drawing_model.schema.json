{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drawing_model.schema.json",
  "title": "DRAWING_MODEL",
  "type": "object",
  "required": ["version", "drawing_id", "units", "layers", "entities_summary", "uncertainties"],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "drawing_id": { "type": "string" },
    "source": { "type": "string" },
    "units": { "type": "string", "enum": ["mm", "cm", "m"] },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "entity_count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "entities_summary": {
      "type": "object",
      "required": ["line_count", "text_count", "dimension_count", "block_count"],
      "properties": {
        "line_count": { "type": "integer", "minimum": 0 },
        "text_count": { "type": "integer", "minimum": 0 },
        "dimension_count": { "type": "integer", "minimum": 0 },
        "block_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "spaces": { "type": "array", "items": { "type": "object" } },
    "openings": { "type": "array", "items": { "type": "object" } },
    "uncertainties": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
