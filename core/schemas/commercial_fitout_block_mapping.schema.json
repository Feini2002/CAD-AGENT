{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commercial_fitout_block_mapping.schema.json",
  "title": "COMMERCIAL_FITOUT_BLOCK_MAPPING",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scene_id",
    "mapping_id",
    "block_library_path",
    "policy",
    "disabled_conditions",
    "entries"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "scene_id": { "type": "string", "const": "commercial_fitout" },
    "mapping_id": { "type": "string", "minLength": 1 },
    "block_library_path": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_arbitrary_block_names", "require_mapping_entry", "fallback_when_block_missing"],
      "properties": {
        "allow_arbitrary_block_names": { "type": "boolean", "enum": [false] },
        "require_mapping_entry": { "type": "boolean" },
        "fallback_when_block_missing": {
          "type": "string",
          "enum": ["object_spec", "symbol_glyph", "deferred"]
        }
      }
    },
    "disabled_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalog_object_id", "subscenes", "fallback_mode"],
        "properties": {
          "catalog_object_id": { "type": "string", "minLength": 1 },
          "primary_block_id": { "type": "string", "minLength": 1 },
          "fallback_mode": {
            "type": "string",
            "enum": ["object_spec", "symbol_glyph", "deferred"]
          },
          "subscenes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["open_office", "meeting_room", "reception"]
            }
          },
          "rotation_allowed": { "type": "boolean" },
          "disabled_when": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "member_mappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["member_role", "primary_block_id", "fallback_mode"],
              "properties": {
                "member_role": { "type": "string", "minLength": 1 },
                "primary_block_id": { "type": "string", "minLength": 1 },
                "fallback_mode": {
                  "type": "string",
                  "enum": ["object_spec", "symbol_glyph", "deferred"]
                }
              }
            }
          }
        },
        "anyOf": [
          { "required": ["primary_block_id"] },
          { "required": ["member_mappings"] }
        ]
      }
    }
  }
}
