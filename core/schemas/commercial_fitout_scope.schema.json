{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commercial_fitout_scope.schema.json",
  "title": "COMMERCIAL_FITOUT_SCOPE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scene_id",
    "product_alpha_status",
    "primary_subscenes",
    "delivery_commitments",
    "subscenes"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "scene_id": { "type": "string", "const": "commercial_fitout" },
    "product_alpha_status": {
      "type": "string",
      "enum": ["scope_defined", "object_catalog", "block_mapping", "benchmark", "sample_confirmation", "cad_smoke", "product_boundary"]
    },
    "primary_subscenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["open_office", "meeting_room", "reception"]
      }
    },
    "delivery_commitments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provides", "explicitly_not"],
      "properties": {
        "provides": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "explicitly_not": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "subscenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subscene_id",
          "display_name",
          "trigger_terms",
          "typical_objects",
          "core_inputs",
          "out_of_subscene"
        ],
        "properties": {
          "subscene_id": {
            "type": "string",
            "enum": ["open_office", "meeting_room", "reception"]
          },
          "display_name": { "type": "string", "minLength": 1 },
          "trigger_terms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "typical_objects": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "core_inputs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "out_of_subscene": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "deferred_legacy_workflows": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "object_catalog_path": { "type": "string", "minLength": 1 },
    "block_mapping_path": { "type": "string", "minLength": 1 }
  }
}
