{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "style_candidates.schema.json",
  "title": "STYLE_CANDIDATES",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "scenario",
    "styleIntent",
    "generationMethod",
    "selection",
    "candidates",
    "evidenceBoundary"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["style-candidates/v1"] },
    "caseId": { "type": "string" },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "drawingType", "expressionPurpose"],
      "properties": {
        "domain": { "type": "string" },
        "drawingType": { "type": "string" },
        "expressionPurpose": { "type": "string" }
      }
    },
    "styleIntent": { "type": "string" },
    "generationMethod": { "type": "string" },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedCandidateId", "needsUserChoice", "autoSelectPolicy"],
      "properties": {
        "selectedCandidateId": { "type": "string" },
        "needsUserChoice": { "type": "boolean" },
        "autoSelectPolicy": { "type": "string" }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "label", "summary", "parameters", "rationale", "tradeoffs"],
        "properties": {
          "candidateId": { "type": "string" },
          "label": { "type": "string" },
          "summary": { "type": "string" },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectType",
              "objectName",
              "width",
              "depth",
              "basePoint",
              "styleToken",
              "includeLabel",
              "includeDimensions",
              "textHierarchy",
              "lineSpacing",
              "density",
              "layerStrategy"
            ],
            "properties": {
              "objectType": { "type": "string" },
              "objectName": { "type": "string" },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "depth": { "type": "number", "exclusiveMinimum": 0 },
              "basePoint": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": { "type": "number" }
              },
              "styleToken": { "type": "string" },
              "includeLabel": { "type": "boolean" },
              "includeDimensions": { "type": "boolean" },
              "textHierarchy": { "type": "string" },
              "lineSpacing": { "type": "number" },
              "density": { "type": "string" },
              "layerStrategy": { "type": "string" }
            }
          },
          "rationale": { "type": "string" },
          "tradeoffs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidenceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "notChecked"],
      "properties": {
        "checked": { "type": "array", "items": { "type": "string" } },
        "notChecked": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
