{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route_audit_report.schema.json",
  "title": "ROUTE_AUDIT_REPORT",
  "type": "object",
  "required": [
    "version",
    "report_id",
    "context_id",
    "routing_summary",
    "scene",
    "evidence",
    "deferred_items",
    "human_summary"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "report_id": { "type": "string" },
    "context_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "routing_summary": {
      "type": "object",
      "required": [
        "request_kind",
        "activated_scene_id",
        "scene_module_enabled",
        "selected_workflow_id",
        "workflow_selection_reason",
        "orchestrator_status"
      ],
      "properties": {
        "request_kind": { "type": "string" },
        "activated_scene_id": { "type": "string" },
        "scene_module_enabled": { "type": "boolean" },
        "selected_workflow_id": { "type": "string" },
        "workflow_selection_reason": { "type": "string" },
        "orchestrator_status": { "type": "string" },
        "entrypoint": { "type": "string" },
        "may_execute": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": ["activation_status", "maturity", "match_reason"],
      "properties": {
        "activation_status": { "type": "string" },
        "maturity": { "type": "string" },
        "match_reason": { "type": "string" },
        "scene_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "disabled_conditions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["available", "deferred", "not_claimable"],
      "properties": {
        "available": { "type": "array", "items": { "type": "string" } },
        "deferred": { "type": "array", "items": { "type": "string" } },
        "not_claimable": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "deferred_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "reason"],
        "properties": {
          "item": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "request_gate_status": { "type": "string" },
    "workflow_dispatch_status": { "type": "string" },
    "execution_status": { "type": "string" },
    "human_summary": { "type": "string" }
  },
  "additionalProperties": false
}
