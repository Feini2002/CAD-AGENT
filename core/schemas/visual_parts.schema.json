{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VISUAL_PARTS",
  "type": "object",
  "required": ["schema_version", "object", "parts", "layout", "forbidden", "sizing"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "case_id": { "type": "string" },
    "round": { "type": "string" },
    "object": { "type": "string" },
    "seat_count": { "type": "integer", "minimum": 0 },
    "style_target": { "type": "string" },
    "style_target_source": {
      "type": "string",
      "enum": ["reference_crop", "user_reference", "reference_screenshot"]
    },
    "style_target_evidence": {
      "type": "object",
      "required": ["source_image", "reference_handle", "reference_block", "derived_from_real_cad_screenshot"],
      "properties": {
        "source_image": { "type": "string" },
        "crop_box_px": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "integer", "minimum": 0 }
        },
        "reference_handle": { "type": "string" },
        "reference_block": { "type": "string" },
        "derived_from_real_cad_screenshot": { "type": "boolean" },
        "generated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "shape", "closed"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "shape": {
            "type": "string",
            "enum": ["rounded_rect", "pill_horizontal", "rounded_rect_tall", "rounded_rect_wide"]
          },
          "closed": { "type": "boolean" },
          "position": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "layout": {
      "type": "object",
      "required": ["assembly"],
      "properties": {
        "assembly": { "type": "string" },
        "symmetry": { "type": "string" },
        "seat_protrude_past_arm_mm": { "type": "number" },
        "part_order": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "forbidden": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sizing": {
      "type": "object",
      "required": ["target_width_mm"],
      "properties": {
        "target_width_mm": { "type": "number", "exclusiveMinimum": 0 },
        "height_mm": { "type": "number", "exclusiveMinimum": 0 },
        "gap_from_reference_mm": { "type": "number" },
        "round_to_mm": { "type": "number", "exclusiveMinimum": 0 },
        "fillet_mm_approx": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "audit_expectations": {
      "type": "object",
      "properties": {
        "required_part_count": { "type": "integer", "minimum": 0 },
        "all_parts_closed": { "type": "boolean" },
        "visual_review_required": { "type": "boolean" },
        "machine_audit_is_necessary_not_sufficient": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
