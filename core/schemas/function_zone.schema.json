{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "function_zone.schema.json",
  "title": "FUNCTION_ZONE",
  "type": "object",
  "required": [
    "version",
    "zone_id",
    "shell_id",
    "name",
    "purpose",
    "boundary",
    "geometry",
    "area",
    "depth",
    "frontage",
    "side_of_path",
    "candidate_functions",
    "preferred_objects",
    "constraints",
    "score",
    "uncertainties"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "zone_id": { "type": "string" },
    "shell_id": { "type": "string" },
    "name": { "type": "string" },
    "purpose": { "type": "string" },
    "boundary": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "max": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "max": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
      },
      "additionalProperties": false
    },
    "area": { "type": "number", "minimum": 0 },
    "depth": { "type": "number", "minimum": 0 },
    "frontage": { "type": "number", "minimum": 0 },
    "side_of_path": { "type": "string", "enum": ["left", "right", "end", "along_wall", "unknown"] },
    "candidate_functions": { "type": "array", "items": { "type": "string" } },
    "preferred_objects": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "score": { "type": "number", "minimum": 0 },
    "uncertainties": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
