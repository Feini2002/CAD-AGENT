{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "style_profile.schema.json",
  "title": "STYLE_PROFILE",
  "type": "object",
  "required": ["version", "style_id", "name", "tokens", "rules"],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "style_id": { "type": "string" },
    "name": { "type": "string" },
    "tokens": {
      "type": "object",
      "required": ["detail_level", "label_policy", "line_weight"],
      "properties": {
        "detail_level": { "type": "string", "enum": ["low", "medium", "high"] },
        "label_policy": { "type": "string", "enum": ["none", "object_name", "object_and_size"] },
        "line_weight": { "type": "string" }
      },
      "additionalProperties": false
    },
    "rules": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
