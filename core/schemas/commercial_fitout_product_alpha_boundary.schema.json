{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commercial_fitout_product_alpha_boundary.schema.json",
  "title": "COMMERCIAL_FITOUT_PRODUCT_ALPHA_BOUNDARY",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scene_id",
    "rollup_id",
    "maturity",
    "primary_subscenes",
    "deidentified_project_samples",
    "completed_packages",
    "declarable_capabilities",
    "non_declarable",
    "next_gaps_to_scene_product",
    "status_page_sync"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "scene_id": { "type": "string", "const": "commercial_fitout" },
    "rollup_id": { "type": "string", "minLength": 1 },
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "declares_scene_product_complete",
        "product_alpha_status",
        "status_page_wording"
      ],
      "properties": {
        "level": { "type": "string", "enum": ["scene_product_alpha"] },
        "declares_scene_product_complete": { "type": "boolean", "const": false },
        "product_alpha_status": { "type": "string", "enum": ["product_boundary"] },
        "status_page_wording": { "type": "string", "minLength": 1 }
      }
    },
    "primary_subscenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": ["open_office", "meeting_room", "reception"]
      }
    },
    "deidentified_project_samples": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subscene_id",
          "sample_id",
          "project_rel",
          "workflow_rel",
          "rollup_manifest_registered",
          "geometry_verified_scope",
          "rcad_followup"
        ],
        "properties": {
          "subscene_id": {
            "type": "string",
            "enum": ["open_office", "meeting_room", "reception"]
          },
          "sample_id": { "type": "string", "minLength": 1 },
          "project_rel": { "type": "string", "minLength": 1 },
          "workflow_rel": { "type": "string", "minLength": 1 },
          "rollup_manifest_registered": { "type": "boolean", "const": true },
          "geometry_verified_scope": { "type": "string", "minLength": 1 },
          "rcad_followup": { "type": "string", "minLength": 1 }
        }
      }
    },
    "completed_packages": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["package_id", "evidence", "tests"],
        "properties": {
          "package_id": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "tests": { "type": "string" },
          "geometry_verified_scope": { "type": "string" },
          "real_autocad_deferred": { "type": "boolean" }
        }
      }
    },
    "declarable_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "summary", "evidence_type", "geometry_verified"],
        "properties": {
          "id": { "type": "string" },
          "summary": { "type": "string" },
          "evidence_type": { "type": "string" },
          "geometry_verified": { "type": "boolean" },
          "geometry_verified_note": { "type": "string" }
        }
      }
    },
    "non_declarable": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "next_gaps_to_scene_product": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "status_page_sync": {
      "type": "object",
      "required": [
        "core_status_scene_line",
        "cad_agent_status_scene_line",
        "agent_multi_scene_progress_note"
      ],
      "properties": {
        "core_status_scene_line": { "type": "string" },
        "cad_agent_status_scene_line": { "type": "string" },
        "agent_multi_scene_progress_note": { "type": "string" }
      }
    }
  }
}
