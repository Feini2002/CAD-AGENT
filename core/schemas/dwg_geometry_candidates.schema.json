{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dwg_geometry_candidates.schema.json",
  "title": "DWG_GEOMETRY_CANDIDATES",
  "type": "object",
  "required": [
    "version",
    "read_only",
    "source",
    "wall_segment_candidates",
    "door_opening_candidates",
    "column_candidates",
    "no_place_zone_candidates",
    "counts"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0.1"] },
    "read_only": { "type": "boolean" },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "entity_summary_ref": { "type": "object" },
    "wall_segment_candidates": { "type": "array" },
    "door_opening_candidates": { "type": "array" },
    "column_candidates": { "type": "array" },
    "no_place_zone_candidates": { "type": "array" },
    "counts": {
      "type": "object",
      "required": ["wall_segments", "door_openings", "columns", "no_place_zones"],
      "properties": {
        "wall_segments": { "type": "integer", "minimum": 0 },
        "door_openings": { "type": "integer", "minimum": 0 },
        "columns": { "type": "integer", "minimum": 0 },
        "no_place_zones": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
