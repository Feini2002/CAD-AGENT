{
  "version": "0.1",
  "manifest_id": "nightly-lab-tier-manifest-v1",
  "package_id": "V-PROOF-72-NIGHTLY-LAB-ENTRY",
  "description": "Capability Lab tier steps for nightly / CI entry (default no-CAD for L1).",
  "default_coverage_output": "output/validation_runs/capability-lab/cad_capability_coverage.json",
  "tiers": {
    "L0": {
      "display_name": "Coverage-only smoke",
      "requires_real_cad": false,
      "steps": [
        {
          "step_id": "coverage",
          "title": "Registry coverage (V-PROOF-02)",
          "script": "scripts/run_capability_coverage.py",
          "args": [
            "--output",
            "{output_dir}/cad_capability_coverage.json"
          ]
        }
      ]
    },
    "L1": {
      "display_name": "Nightly no-CAD capability lab",
      "requires_real_cad": false,
      "steps": [
        {
          "step_id": "self_check",
          "title": "Environment self check",
          "script": "scripts/self_check.py",
          "args": []
        },
        {
          "step_id": "negative_plan_suite",
          "title": "Negative CAD_PLAN suite (LCAD-10)",
          "script": "scripts/run_negative_cad_plan_suite.py",
          "args": ["--output", "{output_dir}/negative_cad_plan_suite.json"]
        },
        {
          "step_id": "local_cad_regression_no_cad",
          "title": "Local CAD regression matrix (no-CAD)",
          "script": "scripts/run_local_cad_regression.py",
          "args": ["--no-cad", "--output-dir", "{output_dir}/local_cad_regression"],
          "accept_mode": "no_cad_lab"
        },
        {
          "step_id": "cad_validation_no_cad",
          "title": "CAD validation runner (no-CAD)",
          "script": "scripts/run_cad_validation.py",
          "args": [
            "--no-cad",
            "--environment-optional",
            "--output-dir",
            "{output_dir}/cad_validation"
          ],
          "accept_mode": "no_cad_lab"
        },
        {
          "step_id": "coverage",
          "title": "Registry coverage (V-PROOF-02)",
          "script": "scripts/run_capability_coverage.py",
          "args": [
            "--output",
            "{output_dir}/cad_capability_coverage.json"
          ]
        },
        {
          "step_id": "project_sample_protocol",
          "title": "Project sample protocol scan (PROJ-02)",
          "script": "scripts/run_project_sample_protocol_scan.py",
          "args": ["--output", "{output_dir}/project_sample_protocol_scan.json"]
        }
      ]
    }
  }
}
