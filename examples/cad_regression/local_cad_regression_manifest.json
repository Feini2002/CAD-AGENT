{
  "version": "0.1",
  "suite_id": "local_cad_regression",
  "description": "Manifest for local CODEX_PREVIEW CAD regression cases. Each case declares whether real AutoCAD readback is required before any geometry claim can be made.",
  "safety": {
    "layer": "CODEX_PREVIEW",
    "saved_dwg": false,
    "deleted_entities": false,
    "modified_formal_layers": false
  },
  "cases": [
    {
      "id": "baseline_cad_validation",
      "title": "Baseline CAD validation runner",
      "entrypoint": "scripts/run_cad_validation.py",
      "requires_real_cad": true,
      "expected_evidence_state": "readback_geometry_verified",
      "output_path": "baseline_cad_validation/report.json",
      "command": [
        "scripts/run_cad_validation.py",
        "--output-dir",
        "{output_dir}/baseline_cad_validation"
      ],
      "safety": {
        "layer": "CODEX_PREVIEW",
        "saved_dwg": false,
        "deleted_entities": false,
        "modified_formal_layers": false
      }
    },
    {
      "id": "project_sample_cad_check",
      "title": "Project sample CODEX_PREVIEW CAD check",
      "entrypoint": "scripts/run_project_sample_cad_check.py",
      "requires_real_cad": true,
      "expected_evidence_state": "geometry_verified",
      "output_path": "project_sample_cad/project_sample_cad_check_report.json",
      "command": [
        "scripts/run_project_sample_cad_check.py",
        "--workflow-output-dir",
        "{output_dir}/project_sample_workflow",
        "--output-dir",
        "{output_dir}/project_sample_cad",
        "--start-x",
        "34000",
        "--start-y",
        "18000"
      ],
      "safety": {
        "layer": "CODEX_PREVIEW",
        "saved_dwg": false,
        "deleted_entities": false,
        "modified_formal_layers": false
