# Local CAD/project history that should not ship with the portable kit
docs/archive/

# Training case round memory is portable evidence and should be trackable.
# Ignore only caches/temp files inside runs/.
projects/*/runs/__pycache__/
projects/*/runs/*.py[cod]
projects/*/runs/*.tmp
projects/*/runs/*.log

# Obsolete generated style targets are not valid Visual-First evidence.
projects/*/expected/style_target_2seat.png

# Generated output artifacts
#
# Private-repo migration policy:
# keep durable CAD / training evidence portable by default, so another
# computer can restore the workbench without retraining.
#
# Still ignore only short-lived debug/test output below.
output/*
!output/
!output/previews/
!output/previews/**
!output/training_queues/
!output/training_queues/**
!output/training_learning/
!output/training_learning/**
!output/validation_runs/
!output/validation_runs/**
!output/runs/
!output/runs/**
!output/model_reviews/
!output/model_reviews/**
output/debug/
output/test_artifacts/
output/**/__pycache__/
output/**/*.py[cod]
output/**/*.tmp
output/**/*.log

# Local CodeGraph index/cache. Rebuild per machine with `codegraph init -i`.
.codegraph/

# Understand Anything local/generated files.
# Keep config files trackable, but do not commit generated graph snapshots by default.
.understand-anything/*
!.understand-anything/.understandignore
!.understand-anything/config.json

# Local tool logs
cad_mcp.log

# Python/runtime caches
__pycache__/
*.py[cod]
.pytest_cache/

# Local environment files
.env
**/.dev.vars
.venv/
venv/
node_modules/
.wrangler/
.wrangler-config/
.wrangler-*/
tmp-worker-*.log
tmp-worker-*.txt

# CAD lock/temp files
*.dwl
*.dwl2
*.bak

# User-approved CAD references are portable development inputs and may be committed.
